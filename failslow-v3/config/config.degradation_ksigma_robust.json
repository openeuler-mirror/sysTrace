{
  "logging": {
    "level": "DEBUG"
  },
  "tasks": [
    {
      "task_name": "degradation_detection",
      "task_type": "degradation",
      "enable_group_detection": false,
      "detect_interval_seconds": 30.0,
      "hccl_restore": null,
      "data_source": {
        "type": "degradation_step_csv",
        "params": {
          "directory_path": "/home/sysTrace/mspti/",
          "file_pattern": "training-step-time-*.csv",
          "max_workers": 4
        }
      },
      "data_sink": {
        "type": "local_csv",
        "enabled": false,
        "params": {
          "output_directory": "/home/sysTrace/local/data/sink/degradation/",
          "format": "hccl"
        }
      },
      "metric_extractors": [
        {
          "type": "degradation_extractor",
          "enabled": true
        }
      ],
      "preprocessors": [
        {
          "type": "step_aggregator",
          "enabled": true,
          "params": {
            "steps_per_group": 1
          }
        }
      ],
      "detectors": [
        {
          "type": "degradation_ksigma_robust",
          "enabled": true,
          "params": {
            "window_size": 10,
            "k_sigma": 2.0,
            "anomaly_degree_thr": 0.15,
            "use_variable_window": true,
            "window_increase_ratio": 0.5,
            "eps": 1e-6,
            "min_consecutive": 6,
            "detect_rise": true,
            "detect_drop": false,
            "plt_save_path": "/home/sysTrace/local/output/degradation/"
          }
        }
      ],
      "alert_reporters": [
        {
          "type": "console",
          "enabled": true,
          "params": {
            "level": "INFO"
          }
        },
        {
          "type": "file",
          "enabled": true,
          "params": {
            "output_path": "/home/sysTrace/local/output/degradation_alerts.json",
            "format": "json"
          }
        }
      ]
    }
  ]
}
