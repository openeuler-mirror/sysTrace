/(@target_pid == 0 || pid == @target_pid) && (@target_cpu < 0 || cpu == @target_cpu) && @start[tid]/
{
    $start_us = (@start[tid] - @start_time) / 1000;
    $dur_us   = (nsecs - @start[tid]) / 1000;
    $lock     = @lock_addr[tid];

    if (@first) { printf("{\"name\":\"pthread_mutex_unlock\",\"cat\":\"lock\",\"ph\":\"X\",\"pid\":%d,\"tid\":\"%s\",\"ts\":%d,\"dur\":%d,\"args\":{\"comm\":\"%s\",\"cpu\":%d,\"lock_address\":\"0x%x\"}}", pid, comm, $start_us, $dur_us, comm, cpu, $lock); @first=0; }
    else { printf(",\n{\"name\":\"pthread_mutex_unlock\",\"cat\":\"lock\",\"ph\":\"X\",\"pid\":%d,\"tid\":\"%s\",\"ts\":%d,\"dur\":%d,\"args\":{\"comm\":\"%s\",\"cpu\":%d,\"lock_address\":\"0x%x\"}}", pid, comm, $start_us, $dur_us, comm, cpu, $lock); }

    delete(@start[tid]);
    delete(@lock_addr[tid]);
}

